<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BusGoMobile.Pages.RegisterPage"
             BackgroundColor="{StaticResource BgSurfaceContainerLowest}"
             Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Padding="24,0,24,28" Spacing="0">

            <!-- ÜST: geri + ambient glow + hero -->
            <Grid Margin="0,16,0,0" ColumnDefinitions="Auto,*">
                <Border Grid.Column="0"
                        WidthRequest="40" HeightRequest="40"
                        StrokeShape="RoundRectangle 12"
                        BackgroundColor="{StaticResource BgSurfaceContainerLow}"
                        VerticalOptions="Start">
                    <Label Text="‹" FontSize="24"
                           TextColor="{StaticResource BgOnSurface}"
                           HorizontalOptions="Center" VerticalOptions="Center" />
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBackTapped" />
                    </Border.GestureRecognizers>
                </Border>
            </Grid>

            <!-- Hero: marka + hediye vurgusu -->
            <Grid Margin="0,16,0,0">
                <Ellipse WidthRequest="200" HeightRequest="200"
                         Fill="{StaticResource BgSecondaryContainer}"
                         Opacity="0.10"
                         HorizontalOptions="End" VerticalOptions="Start"
                         Margin="0,-40,-50,0" />

                <VerticalStackLayout Spacing="10">
                    <HorizontalStackLayout Spacing="8">
                        <Border WidthRequest="30" HeightRequest="30"
                                StrokeShape="RoundRectangle 9"
                                BackgroundColor="{StaticResource BgSecondaryContainer}"
                                VerticalOptions="Center">
                            <Label Text="{StaticResource IconBus}"
                                   FontFamily="MaterialSymbols" FontSize="17"
                                   TextColor="White"
                                   HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <Label Text="BusGo"
                               FontFamily="InterExtraBold" FontSize="18"
                               TextColor="{StaticResource BgOnSurface}"
                               VerticalOptions="Center" />
                    </HorizontalStackLayout>

                    <Label Text="Aramıza Katıl."
                           FontFamily="InterExtraBold" FontSize="28"
                           TextColor="{StaticResource BgOnSurface}"
                           Margin="0,6,0,0" />
                    <Label Text="Hesabını oluştur, biletlerini tek yerden yönet ve avantajlardan hemen yararlanmaya başla."
                           FontFamily="InterRegular" FontSize="14"
                           TextColor="{StaticResource BgOnSurfaceVariant}"
                           LineHeight="1.35" />

                    <!-- Hediye şeridi -->
                    <Border StrokeShape="RoundRectangle 12"
                            BackgroundColor="{StaticResource BgSecondaryFixedDim}"
                            Padding="12,10" Margin="0,4,0,0">
                        <Grid ColumnDefinitions="Auto,*">
                            <Border Grid.Column="0"
                                    WidthRequest="34" HeightRequest="34"
                                    StrokeShape="RoundRectangle 10"
                                    BackgroundColor="{StaticResource BgSecondaryContainer}"
                                    VerticalOptions="Center">
                                <Label Text="{StaticResource IconConfirmationNumber}"
                                       FontFamily="MaterialSymbols" FontSize="18"
                                       TextColor="White"
                                       HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="0"
                                                 VerticalOptions="Center" Margin="10,0,0,0">
                                <Label Text="İlk biletine özel 50 TL puan"
                                       FontFamily="InterBold" FontSize="13"
                                       TextColor="{StaticResource BgOnSecondaryContainer}" />
                                <Label Text="Kayıt olur olmaz hesabına tanımlanır."
                                       FontFamily="InterRegular" FontSize="11"
                                       TextColor="{StaticResource BgOnSecondaryContainer}" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </VerticalStackLayout>
            </Grid>

            <!-- FORM -->
            <VerticalStackLayout Spacing="16" Margin="0,24,0,0">

                <!-- Ad + Soyad -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <VerticalStackLayout Grid.Column="0" Spacing="7">
                        <Label Text="Ad" FontFamily="InterSemiBold" FontSize="13"
                               TextColor="{StaticResource BgOnSurface}" />
                        <Border x:Name="FirstNameBorder"
                                StrokeShape="RoundRectangle 14"
                                BackgroundColor="{StaticResource BgSurfaceContainerLow}"
                                Stroke="{StaticResource BgOutlineVariant}" StrokeThickness="1"
                                Padding="14,0" HeightRequest="54">
                            <Entry x:Name="FirstNameEntry"
                                   Placeholder="Adınız"
                                   FontFamily="InterMedium" FontSize="15"
                                   TextColor="{StaticResource BgOnSurface}"
                                   PlaceholderColor="{StaticResource BgOutline}"
                                   BackgroundColor="Transparent"
                                   VerticalOptions="Center"
                                   Focused="OnEntryFocused" Unfocused="OnEntryUnfocused" />
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Grid.Column="1" Spacing="7">
                        <Label Text="Soyad" FontFamily="InterSemiBold" FontSize="13"
                               TextColor="{StaticResource BgOnSurface}" />
                        <Border x:Name="LastNameBorder"
                                StrokeShape="RoundRectangle 14"
                                BackgroundColor="{StaticResource BgSurfaceContainerLow}"
                                Stroke="{StaticResource BgOutlineVariant}" StrokeThickness="1"
                                Padding="14,0" HeightRequest="54">
                            <Entry x:Name="LastNameEntry"
                                   Placeholder="Soyadınız"
                                   FontFamily="InterMedium" FontSize="15"
                                   TextColor="{StaticResource BgOnSurface}"
                                   PlaceholderColor="{StaticResource BgOutline}"
                                   BackgroundColor="Transparent"
                                   VerticalOptions="Center"
                                   Focused="OnEntryFocused" Unfocused="OnEntryUnfocused" />
                        </Border>
                    </VerticalStackLayout>
                </Grid>

                <!-- E-posta -->
                <VerticalStackLayout Spacing="7">
                    <Label Text="E-posta Adresi" FontFamily="InterSemiBold" FontSize="13"
                           TextColor="{StaticResource BgOnSurface}" />
                    <Border x:Name="EmailBorder"
                            StrokeShape="RoundRectangle 14"
                            BackgroundColor="{StaticResource BgSurfaceContainerLow}"
                            Stroke="{StaticResource BgOutlineVariant}" StrokeThickness="1"
                            Padding="14,0" HeightRequest="54">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <Label Grid.Column="0" x:Name="EmailIcon"
                                   Text="{StaticResource IconMail}"
                                   FontFamily="MaterialSymbols" FontSize="20"
                                   TextColor="{StaticResource BgOutline}"
                                   VerticalOptions="Center" />
                            <Entry Grid.Column="1"
                                   x:Name="EmailEntry"
                                   Placeholder="ad.soyad@ornek.com"
                                   Keyboard="Email"
                                   FontFamily="InterMedium" FontSize="15"
                                   TextColor="{StaticResource BgOnSurface}"
                                   PlaceholderColor="{StaticResource BgOutline}"
                                   BackgroundColor="Transparent"
                                   VerticalOptions="Center"
                                   Focused="OnEntryFocused" Unfocused="OnEntryUnfocused" />
                        </Grid>
                    </Border>
                </VerticalStackLayout>

                <!-- Telefon -->
                <VerticalStackLayout Spacing="7">
                    <Label Text="Cep Telefonu" FontFamily="InterSemiBold" FontSize="13"
                           TextColor="{StaticResource BgOnSurface}" />
                    <Border x:Name="PhoneBorder"
                            StrokeShape="RoundRectangle 14"
                            BackgroundColor="{StaticResource BgSurfaceContainerLow}"
                            Stroke="{StaticResource BgOutlineVariant}" StrokeThickness="1"
                            Padding="14,0" HeightRequest="54">
                        <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="10">
                            <Label Grid.Column="0" Text="+90"
                                   FontFamily="InterBold" FontSize="15"
                                   TextColor="{StaticResource BgOnSurface}"
                                   VerticalOptions="Center" />
                            <BoxView Grid.Column="1" WidthRequest="1"
                                     Color="{StaticResource BgOutlineVariant}"
                                     Margin="2,14" />
                            <Entry Grid.Column="2"
                                   x:Name="PhoneEntry"
                                   Placeholder="5XX XXX XX XX"
                                   Keyboard="Telephone"
                                   MaxLength="10"
                                   FontFamily="InterMedium" FontSize="15"
                                   TextColor="{StaticResource BgOnSurface}"
                                   PlaceholderColor="{StaticResource BgOutline}"
                                   BackgroundColor="Transparent"
                                   VerticalOptions="Center"
                                   Focused="OnEntryFocused" Unfocused="OnEntryUnfocused" />
                        </Grid>
                    </Border>
                </VerticalStackLayout>

                <!-- Şifre -->
                <VerticalStackLayout Spacing="7">
                    <Label Text="Şifre" FontFamily="InterSemiBold" FontSize="13"
                           TextColor="{StaticResource BgOnSurface}" />
                    <Border x:Name="PasswordBorder"
                            StrokeShape="RoundRectangle 14"
                            BackgroundColor="{StaticResource BgSurfaceContainerLow}"
                            Stroke="{StaticResource BgOutlineVariant}" StrokeThickness="1"
                            Padding="14,0" HeightRequest="54">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                            <Label Grid.Column="0" x:Name="PasswordIcon"
                                   Text="{StaticResource IconLock}"
                                   FontFamily="MaterialSymbols" FontSize="20"
                                   TextColor="{StaticResource BgOutline}"
                                   VerticalOptions="Center" />
                            <Entry Grid.Column="1"
                                   x:Name="PasswordEntry"
                                   Placeholder="En az 8 karakter"
                                   IsPassword="True"
                                   FontFamily="InterMedium" FontSize="15"
                                   TextColor="{StaticResource BgOnSurface}"
                                   PlaceholderColor="{StaticResource BgOutline}"
                                   BackgroundColor="Transparent"
                                   VerticalOptions="Center"
                                   TextChanged="OnPasswordChanged"
                                   Focused="OnEntryFocused" Unfocused="OnEntryUnfocused" />
                            <Label Grid.Column="2"
                                   x:Name="PassEyeIcon"
                                   Text="{StaticResource IconVisibility}"
                                   FontFamily="MaterialSymbols" FontSize="20"
                                   TextColor="{StaticResource BgOutline}"
                                   VerticalOptions="Center">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnTogglePasswordTapped" />
                                </Label.GestureRecognizers>
                            </Label>
                        </Grid>
                    </Border>

                    <!-- Şifre gücü -->
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="5" Margin="0,4,0,0">
                        <BoxView x:Name="StrengthBar1" Grid.Column="0" HeightRequest="5"
                                 CornerRadius="3"
                                 Color="{StaticResource BgSurfaceContainerHighest}" />
                        <BoxView x:Name="StrengthBar2" Grid.Column="1" HeightRequest="5"
                                 CornerRadius="3"
                                 Color="{StaticResource BgSurfaceContainerHighest}" />
                        <BoxView x:Name="StrengthBar3" Grid.Column="2" HeightRequest="5"
                                 CornerRadius="3"
                                 Color="{StaticResource BgSurfaceContainerHighest}" />
                    </Grid>
                    <Label Text="En az 8 karakter, 1 harf ve 1 rakam içermeli."
                           FontFamily="InterRegular" FontSize="11"
                           TextColor="{StaticResource BgOnSurfaceVariant}"
                           Margin="2,0,0,0" />
                </VerticalStackLayout>

                <!-- Onaylar -->
                <VerticalStackLayout Spacing="10" Margin="0,2,0,0">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                        <CheckBox x:Name="TermsCheck" Grid.Column="0"
                                  Color="{StaticResource BgSecondary}"
                                  VerticalOptions="Start" />
                        <Label Grid.Column="1"
                               Text="Kullanım Koşulları ve KVKK Aydınlatma Metni'ni okudum, kabul ediyorum."
                               FontFamily="InterRegular" FontSize="12"
                               TextColor="{StaticResource BgOnSurfaceVariant}"
                               VerticalOptions="Center" />
                    </Grid>
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                        <CheckBox x:Name="MarketingCheck" Grid.Column="0"
                                  IsChecked="True"
                                  Color="{StaticResource BgSecondary}"
                                  VerticalOptions="Start" />
                        <Label Grid.Column="1"
                               Text="Kampanya ve fırsatlardan SMS/e-posta ile haberdar olmak istiyorum."
                               FontFamily="InterRegular" FontSize="12"
                               TextColor="{StaticResource BgOnSurfaceVariant}"
                               VerticalOptions="Center" />
                    </Grid>
                </VerticalStackLayout>

                <!-- Kayıt butonu -->
                <Border StrokeShape="RoundRectangle 16"
                        BackgroundColor="{StaticResource BgSecondaryContainer}"
                        StrokeThickness="0"
                        HeightRequest="56"
                        x:Name="RegisterButtonBorder"
                        Margin="0,6,0,0">
                    <Grid>
                        <HorizontalStackLayout x:Name="RegisterButtonContent"
                                               Spacing="8"
                                               HorizontalOptions="Center" VerticalOptions="Center">
                            <Label Text="Ücretsiz Kayıt Ol"
                                   FontFamily="InterBold" FontSize="16"
                                   TextColor="White" VerticalOptions="Center" />
                            <Label Text="{StaticResource IconArrowForward}"
                                   FontFamily="MaterialSymbols" FontSize="18"
                                   TextColor="White" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                        <ActivityIndicator x:Name="RegisterSpinner"
                                           IsVisible="False" IsRunning="False"
                                           Color="White"
                                           HorizontalOptions="Center" VerticalOptions="Center" />
                    </Grid>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnRegisterClicked" />
                    </Border.GestureRecognizers>
                </Border>

                <!-- Sosyal kayıt (kompakt) -->
                <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="12" Margin="0,4,0,0">
                    <BoxView Grid.Column="0" HeightRequest="1"
                             Color="{StaticResource BgOutlineVariant}" VerticalOptions="Center" />
                    <Label Grid.Column="1" Text="veya"
                           FontFamily="InterRegular" FontSize="12"
                           TextColor="{StaticResource BgOnSurfaceVariant}" />
                    <BoxView Grid.Column="2" HeightRequest="1"
                             Color="{StaticResource BgOutlineVariant}" VerticalOptions="Center" />
                </Grid>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <Border Grid.Column="0"
                            StrokeShape="RoundRectangle 14"
                            BackgroundColor="{StaticResource BgSurfaceContainerLowest}"
                            Stroke="{StaticResource BgOutlineVariant}" StrokeThickness="1"
                            HeightRequest="52">
                        <HorizontalStackLayout Spacing="8" HorizontalOptions="Center" VerticalOptions="Center">
                            <Label Text="G" FontFamily="InterExtraBold" FontSize="16"
                                   TextColor="{StaticResource BgSecondary}" VerticalOptions="Center" />
                            <Label Text="Google" FontFamily="InterSemiBold" FontSize="14"
                                   TextColor="{StaticResource BgOnSurface}" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </Border>
                    <Border Grid.Column="1"
                            StrokeShape="RoundRectangle 14"
                            BackgroundColor="{StaticResource BgSurfaceContainerLowest}"
                            Stroke="{StaticResource BgOutlineVariant}" StrokeThickness="1"
                            HeightRequest="52">
                        <HorizontalStackLayout Spacing="8" HorizontalOptions="Center" VerticalOptions="Center">
                            <Label Text="" FontFamily="InterExtraBold" FontSize="16"
                                   TextColor="{StaticResource BgOnSurface}" VerticalOptions="Center" />
                            <Label Text="Apple" FontFamily="InterSemiBold" FontSize="14"
                                   TextColor="{StaticResource BgOnSurface}" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </Border>
                </Grid>

            </VerticalStackLayout>

            <!-- Giriş linki -->
            <HorizontalStackLayout Spacing="4" HorizontalOptions="Center" Margin="0,24,0,0">
                <Label Text="Zaten bir hesabın var mı?"
                       FontFamily="InterRegular" FontSize="14"
                       TextColor="{StaticResource BgOnSurfaceVariant}" />
                <Label Text="Giriş Yap"
                       FontFamily="InterBold" FontSize="14"
                       TextColor="{StaticResource BgSecondary}">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnGoToLoginTapped" />
                    </Label.GestureRecognizers>
                </Label>
            </HorizontalStackLayout>

            <!-- KVKK notu -->
            <HorizontalStackLayout Spacing="6" HorizontalOptions="Center" Margin="0,14,0,0">
                <Label Text="{StaticResource IconVerifiedUser}"
                       FontFamily="MaterialSymbols" FontSize="14"
                       TextColor="{StaticResource BgSecondary}"
                       VerticalOptions="Center" />
                <Label Text="Kişisel verileriniz 6698 sayılı KVKK kapsamında korunur."
                       FontFamily="InterMedium" FontSize="11"
                       TextColor="{StaticResource BgOnSurfaceVariant}"
                       VerticalOptions="Center" />
            </HorizontalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
