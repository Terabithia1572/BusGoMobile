<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:BusGoMobile.Controls"
             x:Class="BusGoMobile.Pages.HomePage"
             BackgroundColor="{StaticResource BgSurface}"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- ÜST BAR (Header) -->
        <Grid Grid.Row="0"
              BackgroundColor="{StaticResource BgSurface}"
              Padding="16,12"
              ColumnDefinitions="Auto,*,Auto,Auto"
              ColumnSpacing="12">

            <!-- Logo alanı -->
            <Border Grid.Column="0"
                    WidthRequest="32" HeightRequest="32"
                    StrokeShape="RoundRectangle 8"
                    BackgroundColor="{StaticResource BgSecondaryContainer}"
                    VerticalOptions="Center">
                <Label Text="🚌" FontSize="16"
                       HorizontalOptions="Center" VerticalOptions="Center" />
            </Border>

            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="0">
                <Label Text="BusGo"
                       FontSize="17" FontAttributes="Bold"
                       TextColor="{StaticResource BgOnSurface}" />
                <Label Text="Ana Sayfa"
                       FontSize="12"
                       TextColor="{StaticResource BgOnSurfaceVariant}" />
            </VerticalStackLayout>

            <Label Grid.Column="2"
                   Text="🔔" FontSize="20"
                   VerticalOptions="Center" />

            <Border Grid.Column="3"
                    WidthRequest="32" HeightRequest="32"
                    StrokeShape="RoundRectangle 16"
                    BackgroundColor="{StaticResource BgSurfaceContainerHighest}"
                    VerticalOptions="Center">
                <Label Text="👤" FontSize="14"
                       HorizontalOptions="Center" VerticalOptions="Center" />
            </Border>
        </Grid>

        <!-- KAYDIRILABİLİR İÇERİK -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16,8,16,24" Spacing="20">

                <!-- Karşılama + Puan -->
                <Grid ColumnDefinitions="*,Auto">
                    <VerticalStackLayout Grid.Column="0" Spacing="2">
                        <Label Text="Merhaba, Burak 👋"
                               FontSize="14"
                               TextColor="{StaticResource BgOnSurfaceVariant}" />
                        <Label Text="Bugün nereye gitmek istersin?"
                               FontSize="24" FontAttributes="Bold"
                               TextColor="{StaticResource BgOnSurface}" />
                    </VerticalStackLayout>

                    <Border Grid.Column="1"
                            StrokeShape="RoundRectangle 20"
                            BackgroundColor="{StaticResource BgSurfaceContainerHigh}"
                            Padding="10,6"
                            VerticalOptions="Start">
                        <Label Text="⭐ 120 Puan"
                               FontSize="11" FontAttributes="Bold"
                               TextColor="{StaticResource BgOnSurface}" />
                    </Border>
                </Grid>

                <!-- Ulaşım türü sekmeleri (yatay kaydırma) -->
                <!-- Ulaşım türü sekmeleri (veritabanından) -->
                <CollectionView x:Name="CategoriesView"
                                ItemsLayout="HorizontalList"
                                HeightRequest="52">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border StrokeShape="RoundRectangle 20"
                                    BackgroundColor="{StaticResource BgSurfaceContainerLowest}"
                                    Padding="14,10" Margin="0,0,8,0">
                                <HorizontalStackLayout Spacing="6">
                                    <Label Text="{Binding IconGlyph}"
                                           FontFamily="MaterialSymbols" FontSize="18"
                                           TextColor="{StaticResource BgOnSurfaceVariant}"
                                           VerticalOptions="Center" />
                                    <Label Text="{Binding Name}"
                                           FontFamily="InterRegular" FontSize="14"
                                           TextColor="{StaticResource BgOnSurfaceVariant}"
                                           VerticalOptions="Center" />
                                </HorizontalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>


                <!-- KAMPANYA SLIDER (veritabanından) -->
                <VerticalStackLayout Spacing="8">
                    <CarouselView x:Name="CampaignCarousel"
                                  HeightRequest="150"
                                  Loop="True"
                                  IndicatorView="CampaignIndicator">
                        <CarouselView.ItemTemplate>
                            <DataTemplate>
                                <Border StrokeShape="RoundRectangle 12"
                                        StrokeThickness="0"
                                        Margin="0,0,8,0">
                                    <Grid>
                                        <!-- Arka plan görseli -->
                                        <Image Source="{Binding ImageName}"
                                               Aspect="AspectFill" />

                                        <!-- Okunabilirlik için alt karartma -->
                                        <BoxView VerticalOptions="End"
                                                 HeightRequest="80"
                                                 Color="Black"
                                                 Opacity="0.35" />

                                        <!-- Yazılar -->
                                        <VerticalStackLayout VerticalOptions="End"
                                                             Padding="14"
                                                             Spacing="2">
                                            <Label Text="{Binding Title}"
                                                   FontFamily="InterBold" FontSize="17"
                                                   TextColor="White" />
                                            <Label Text="{Binding Subtitle}"
                                                   FontFamily="InterRegular" FontSize="12"
                                                   TextColor="White" />
                                        </VerticalStackLayout>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CarouselView.ItemTemplate>
                    </CarouselView>

                    <!-- Noktalı gösterge -->
                    <IndicatorView x:Name="CampaignIndicator"
                                   IndicatorColor="{StaticResource BgSurfaceContainerHigh}"
                                   SelectedIndicatorColor="{StaticResource BgSecondary}"
                                   IndicatorSize="8"
                                   HorizontalOptions="Center" />
                </VerticalStackLayout>


                <!-- Popüler Firmalar -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="POPÜLER FİRMALAR"
                           FontSize="11" FontAttributes="Bold"
                           TextColor="{StaticResource BgOnSurfaceVariant}" />
                    <ScrollView Orientation="Horizontal"
                                HorizontalScrollBarVisibility="Never">
                        <HorizontalStackLayout Spacing="8">
                            <Border StrokeShape="RoundRectangle 20"
                                    BackgroundColor="{StaticResource BgSurfaceContainerLowest}"
                                    Padding="14,6">
                                <Label Text="✔ Kamil Koç" FontSize="12"
                                       TextColor="{StaticResource BgOnSurface}" />
                            </Border>
                            <Border StrokeShape="RoundRectangle 20"
                                    BackgroundColor="{StaticResource BgSurfaceContainerLowest}"
                                    Padding="14,6">
                                <Label Text="✔ Pamukkale" FontSize="12"
                                       TextColor="{StaticResource BgOnSurface}" />
                            </Border>
                            <Border StrokeShape="RoundRectangle 20"
                                    BackgroundColor="{StaticResource BgSurfaceContainerLowest}"
                                    Padding="14,6">
                                <Label Text="✔ Metro Turizm" FontSize="12"
                                       TextColor="{StaticResource BgOnSurface}" />
                            </Border>
                            <Border StrokeShape="RoundRectangle 20"
                                    BackgroundColor="{StaticResource BgSurfaceContainerLowest}"
                                    Padding="14,6">
                                <Label Text="✔ Varan" FontSize="12"
                                       TextColor="{StaticResource BgOnSurface}" />
                            </Border>
                        </HorizontalStackLayout>
                    </ScrollView>
                </VerticalStackLayout>

                <!-- Kampanya Bandı -->
                <Border StrokeShape="RoundRectangle 12"
                        BackgroundColor="{StaticResource BgSecondaryContainer}"
                        Padding="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Grid.Column="0" Spacing="4">
                            <Label Text="Sonbahar Fırsatı 🍂"
                                   FontSize="11"
                                   TextColor="{StaticResource BgOnSecondary}" />
                            <Label Text="Tüm biletlerde %15 indirim!"
                                   FontSize="17" FontAttributes="Bold"
                                   TextColor="{StaticResource BgOnSecondary}" />
                            <Label Text="Kupon Kodu: BUSGO15"
                                   FontSize="12"
                                   TextColor="{StaticResource BgOnSecondary}" />
                        </VerticalStackLayout>
                        <Label Grid.Column="1" Text="🎫" FontSize="32"
                               VerticalOptions="Center" />
                    </Grid>
                </Border>

                <!-- Son Aramalar -->
                <VerticalStackLayout Spacing="8">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="Son Aramalar"
                               FontSize="17" FontAttributes="Bold"
                               TextColor="{StaticResource BgOnSurface}" />
                        <Label Grid.Column="1" Text="Temizle"
                               FontSize="12"
                               TextColor="{StaticResource BgSecondary}" />
                    </Grid>
                    <ScrollView Orientation="Horizontal"
                                HorizontalScrollBarVisibility="Never">
                        <HorizontalStackLayout Spacing="8">
                            <Border StrokeShape="RoundRectangle 12"
                                    BackgroundColor="{StaticResource BgSurfaceContainerLowest}"
                                    Padding="8" WidthRequest="210">
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="İstanbul → İzmir"
                                           FontSize="14" FontAttributes="Bold"
                                           TextColor="{StaticResource BgOnSurface}" />
                                    <Label Text="12 Ekim  •  1 Yolcu"
                                           FontSize="12"
                                           TextColor="{StaticResource BgOnSurfaceVariant}" />
                                </VerticalStackLayout>
                            </Border>
                            <Border StrokeShape="RoundRectangle 12"
                                    BackgroundColor="{StaticResource BgSurfaceContainerLowest}"
                                    Padding="8" WidthRequest="210">
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="Ankara → Bursa"
                                           FontSize="14" FontAttributes="Bold"
                                           TextColor="{StaticResource BgOnSurface}" />
                                    <Label Text="5 Ekim  •  2 Yolcu"
                                           FontSize="12"
                                           TextColor="{StaticResource BgOnSurfaceVariant}" />
                                </VerticalStackLayout>
                            </Border>
                        </HorizontalStackLayout>
                    </ScrollView>
                </VerticalStackLayout>

                <!-- Popüler Rotalar -->
                <VerticalStackLayout Spacing="8">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="Popüler Rotalar"
                               FontSize="17" FontAttributes="Bold"
                               TextColor="{StaticResource BgOnSurface}" />
                        <Label Grid.Column="1" Text="Tümünü Gör"
                               FontSize="12"
                               TextColor="{StaticResource BgSecondary}" />
                    </Grid>

                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto"
                          ColumnSpacing="8" RowSpacing="8">

                        <Border Grid.Row="0" Grid.Column="0"
                                StrokeShape="RoundRectangle 12"
                                BackgroundColor="{StaticResource BgSurfaceContainerLowest}"
                                Padding="8" HeightRequest="112">
                            <Grid RowDefinitions="Auto,*,Auto">
                                <Label Grid.Row="0" Text="İstanbul → Ankara"
                                       FontSize="14" FontAttributes="Bold"
                                       TextColor="{StaticResource BgOnSurface}" />
                                <Label Grid.Row="1" Text="Günlük 48 sefer"
                                       FontSize="12"
                                       TextColor="{StaticResource BgOnSurfaceVariant}" />
                                <Label Grid.Row="2" Text="450 TL"
                                       FontSize="17" FontAttributes="Bold"
                                       TextColor="{StaticResource BgSecondary}" />
                            </Grid>
                        </Border>

                        <Border Grid.Row="0" Grid.Column="1"
                                StrokeShape="RoundRectangle 12"
                                BackgroundColor="{StaticResource BgSurfaceContainerLowest}"
                                Padding="8" HeightRequest="112">
                            <Grid RowDefinitions="Auto,*,Auto">
                                <Label Grid.Row="0" Text="İzmir → İstanbul"
                                       FontSize="14" FontAttributes="Bold"
                                       TextColor="{StaticResource BgOnSurface}" />
                                <Label Grid.Row="1" Text="Günlük 36 sefer"
                                       FontSize="12"
                                       TextColor="{StaticResource BgOnSurfaceVariant}" />
                                <Label Grid.Row="2" Text="550 TL"
                                       FontSize="17" FontAttributes="Bold"
                                       TextColor="{StaticResource BgSecondary}" />
                            </Grid>
                        </Border>

                        <Border Grid.Row="1" Grid.Column="0"
                                StrokeShape="RoundRectangle 12"
                                BackgroundColor="{StaticResource BgSurfaceContainerLowest}"
                                Padding="8" HeightRequest="112">
                            <Grid RowDefinitions="Auto,*,Auto">
                                <Label Grid.Row="0" Text="Bursa → Antalya"
                                       FontSize="14" FontAttributes="Bold"
                                       TextColor="{StaticResource BgOnSurface}" />
                                <Label Grid.Row="1" Text="Günlük 22 sefer"
                                       FontSize="12"
                                       TextColor="{StaticResource BgOnSurfaceVariant}" />
                                <Label Grid.Row="2" Text="620 TL"
                                       FontSize="17" FontAttributes="Bold"
                                       TextColor="{StaticResource BgSecondary}" />
                            </Grid>
                        </Border>

                        <Border Grid.Row="1" Grid.Column="1"
                                StrokeShape="RoundRectangle 12"
                                BackgroundColor="{StaticResource BgSurfaceContainerLowest}"
                                Padding="8" HeightRequest="112">
                            <Grid RowDefinitions="Auto,*,Auto">
                                <Label Grid.Row="0" Text="Ankara → Eskişehir"
                                       FontSize="14" FontAttributes="Bold"
                                       TextColor="{StaticResource BgOnSurface}" />
                                <Label Grid.Row="1" Text="Günlük 54 sefer"
                                       FontSize="12"
                                       TextColor="{StaticResource BgOnSurfaceVariant}" />
                                <Label Grid.Row="2" Text="180 TL"
                                       FontSize="17" FontAttributes="Bold"
                                       TextColor="{StaticResource BgSecondary}" />
                            </Grid>
                        </Border>
                    </Grid>
                </VerticalStackLayout>

                <!-- Güven Bandı -->
                <Border StrokeShape="RoundRectangle 12"
                        BackgroundColor="{StaticResource BgSurfaceContainerHigh}"
                        Padding="12">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <Border Grid.Column="0"
                                WidthRequest="40" HeightRequest="40"
                                StrokeShape="RoundRectangle 20"
                                BackgroundColor="{StaticResource BgSurfaceContainerLowest}"
                                VerticalOptions="Center">
                            <Label Text="🛡️" FontSize="20"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <Label Text="%100 Güvenli Ödeme &amp; İptal"
                                   FontSize="14" FontAttributes="Bold"
                                   TextColor="{StaticResource BgOnSurface}" />
                            <Label Text="Kesintisiz iade güvencesi ve 7/24 canlı destek."
                                   FontSize="12"
                                   TextColor="{StaticResource BgOnSurfaceVariant}" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

            </VerticalStackLayout>
        </ScrollView>
        <!-- ALT NAVBAR -->
        <controls:BottomNavBar Grid.Row="2" ActiveTab="home" />
    </Grid>
</ContentPage>

